-- ===== KILL ALL TOGGLE (oneâ€‘shot, loops twice, teleports back, skips outâ€‘ofâ€‘range) =====
createToggle(main2Tab, "Kill All", function(v)
    if not v then return end
    -- immediately turn off the toggle so it doesn't stay on
    for name, obj in pairs(toggles) do
        if name == "Kill All" then
            obj.set(false, true) -- true = ignore callback to prevent reâ€‘trigger
            break
        end
    end
    -- check if we are murderer
    if getMM2Role(LocalPlayer) ~= "Murderer" then
        print("You must be the Murderer to use Kill All.")
        return
    end
    -- Save starting position to teleport back later
    local startCFrame = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.CFrame
    if not startCFrame then
        print("Character not loaded.")
        return
    end
    -- gather alive players (exclude self) within 300 studs
    local maxDistance = 300 -- you can change this value
    local targets = {}
    local myPos = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.Position
    if not myPos then
        print("Character not loaded.")
        return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and isAlive(p) then
            local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = (hrp.Position - myPos).Magnitude
                if dist <= maxDistance then
                    table.insert(targets, p)
                end
            end
        end
    end
    if #targets == 0 then
        print("No alive players within " .. maxDistance .. " studs.")
        return
    end
    -- find knife tool
    local knifeTool = nil
    for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.Name:lower():find("knife") or tool.Name:lower():find("murderer")) then
            knifeTool = tool
            break
        end
    end
    if not knifeTool then
        -- check character as well
        for _, tool in ipairs(LocalPlayer.Character:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name:lower():find("knife") or tool.Name:lower():find("murderer")) then
                knifeTool = tool
                break
            end
        end
    end
    if not knifeTool then
        print("No knife tool found.")
        return
    end
    -- attempt to get the remote event from the knife
    local slashRemote = nil
    for _, child in ipairs(knifeTool:GetDescendants()) do
        if child:IsA("RemoteEvent") and (child.Name:lower():find("slash") or child.Name:lower():find("attack") or child.Name:lower():find("use")) then
            slashRemote = child
            break
        end
    end
    -- if not found, try ReplicatedStorage
    if not slashRemote then
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        if remotes then
            for _, child in ipairs(remotes:GetDescendants()) do
                if child:IsA("RemoteEvent") and (child.Name:lower():find("slash") or child.Name:lower():find("attack") or child.Name:lower():find("use")) then
                    slashRemote = child
                    break
                end
            end
        end
    end
    -- loop twice through all targets
    for loop = 1, 2 do
        for _, target in ipairs(targets) do
            if not isAlive(target) then continue end -- skip if died during loop
            local targetHRP = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
            if not targetHRP then continue end
            local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not myHRP then break end
            -- check if target is still within range
            if (targetHRP.Position - myHRP.Position).Magnitude > maxDistance then
                -- out of range, skip this target
                continue
            end
            -- teleport behind target (offset -0.5 studs back â€“ almost inside)
            local cframe = targetHRP.CFrame * CFrame.new(0, 0, -0.5)
            myHRP.CFrame = cframe
            -- wait a moment so the slash can register properly
            task.wait(0.5)
            -- attempt stab
            if slashRemote then
                pcall(function()
                    slashRemote:FireServer(target)
                end)
            else
                -- fallback: use the tool's activation
                pcall(function()
                    knifeTool:Activate()
                end)
            end
            -- small delay before next target
            task.wait(0.3)
        end
    end
    -- teleport back to starting position
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.CFrame = startCFrame
    end
    print("Kill All completed (2 passes).")
end)

