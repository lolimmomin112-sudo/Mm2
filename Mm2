                return oldIndex(t, k)
            elseif k == "CurrentCamera" then
                -- Spoof camera position to avoid detection based on viewport
                return oldIndex(t, k)
            elseif k == "Humanoid" then
                -- When accessing our own humanoid, spoof walk speed and jump power
                local humanoid = oldIndex(t, k)
                if humanoid and humanoid.Parent == LocalPlayer.Character then
                    return humanoid
                end
            end
        end
        return oldIndex(t, k)
    end)

    -- Extend __newindex to block modifications to critical properties from server
    mt.__newindex = newcclosure(function(t, k, v)
        if not checkcaller() then
            if k == "WalkSpeed" or k == "JumpPower" then
                -- Let it set but we'll override later
                return oldNewIndex(t, k, v)
            end
            if k == "CFrame" and typeof(v) == "CFrame" then
                -- Validate CFrame before allowing server to set it
                local pos = v.Position
                if pos.X ~= pos.X or pos.Y ~= pos.Y or pos.Z ~= pos.Z or math.abs(pos.X) > 1e6 then
                    return
                end
                if math.abs(pos.Y) > 1e6 or math.abs(pos.Z) > 1e6 then
                    return
                end
                -- Allow only if within bounds
                return oldNewIndex(t, k, v)
            end
        end
        return oldNewIndex(t, k, v)
    end)

    -- Extend __namecall to intercept remote calls that might set position
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if not checkcaller() then
            if method == "FireServer" and self:IsA("RemoteEvent") then
                -- Intercept remote events that might contain position data
                local args = {...}
                for i, arg in ipairs(args) do
                    if type(arg) == "CFrame" then
                        local pos = arg.Position
                        if pos.X ~= pos.X or pos.Y ~= pos.Y or pos.Z ~= pos.Z or math.abs(pos.X) > 1e5 then
                            -- Replace with safe position
                            args[i] = CFrame.new(0, 10, 0)
                        end
                    elseif type(arg) == "Vector3" then
                        if arg.X ~= arg.X or arg.Y ~= arg.Y or arg.Z ~= arg.Z or math.abs(arg.X) > 1e5 then
                            args[i] = Vector3.new(0, 10, 0)
                        end
                    end
                end
                -- Call original with sanitized args
                return oldNamecall(self, unpack(args))
            end
        end
        return oldNamecall(self, ...)
    end)

    setreadonly(mt, true)
end
