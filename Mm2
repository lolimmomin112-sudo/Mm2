createButton(settingsTab, "Load Settings", function()
    local overallSuccess, overallErr = pcall(function()
        if not isfile or not isfile("VoltBolt_Clean_Config.json") then
            warn("[LOAD] No config file found.")
            return
        end
        local data = HttpService:JSONDecode(readfile("VoltBolt_Clean_Config.json"))
        -- Load toggles
        for name, val in pairs(data) do
            if toggles[name] then
                local ok, err = pcall(function() toggles[name].set(val) end)
                if not ok then warn("[LOAD] Failed to set toggle '" .. name .. "': " .. tostring(err)) end
            end
        end
        -- Load theme
        if data.Selected_Theme and themeDropdown and themeDropdown.select then
            local ok, err = pcall(function() themeDropdown.select(data.Selected_Theme) end)
            if not ok then warn("[LOAD] Failed to set theme: " .. tostring(err)) end
        end
        -- Load sliders
        if data.WalkSpeed_Value and sliders["WalkSpeed"] then
            local ok, err = pcall(function() sliders["WalkSpeed"].set(data.WalkSpeed_Value) end)
            if not ok then warn("[LOAD] Failed to set WalkSpeed slider: " .. tostring(err)) end
        end
        if data.Aimbot_FOV and sliders["Aimbot FOV Circle"] then
            local ok, err = pcall(function() sliders["Aimbot FOV Circle"].set(data.Aimbot_FOV) end)
            if not ok then warn("[LOAD] Failed to set FOV slider: " .. tostring(err)) end
        end
        if data.Aimbot_Smoothness then
            getgenv().Aimbot_Smoothness = data.Aimbot_Smoothness
            if sliders["Aim Strength"] then
                local ok, err = pcall(function() sliders["Aim Strength"].set(data.Aimbot_Smoothness * 100) end)
                if not ok then warn("[LOAD] Failed to set Aim Strength slider: " .. tostring(err)) end
            end
        end
        if data.FarmRange and sliders["Farm Range"] then
            local ok, err = pcall(function() sliders["Farm Range"].set(data.FarmRange) end)
            if not ok then warn("[LOAD] Failed to set Farm Range slider: " .. tostring(err)) end
        end
        -- Load positions
        if data.Menu_Pos then
            local ok, err = pcall(function()
                mainFrame.Position = UDim2.new(data.Menu_Pos[1], data.Menu_Pos[2], data.Menu_Pos[3], data.Menu_Pos[4])
            end)
            if not ok then warn("[LOAD] Failed to set menu position: " .. tostring(err)) end
        end
        if data.Btn_Pos then
            local ok, err = pcall(function()
                toggleBtn.Position = UDim2.new(data.Btn_Pos[1], data.Btn_Pos[2], data.Btn_Pos[3], data.Btn_Pos[4])
            end)
            if not ok then warn("[LOAD] Failed to set button position: " .. tostring(err)) end
        end
        print("[LOAD] Settings loaded successfully.")
    end)
    if not overallSuccess then
        warn("[LOAD] Error loading settings: " .. tostring(overallErr))
    end
end)

