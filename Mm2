local function TeleportToSafeInnocent(maxDistance)
    maxDistance = maxDistance or Settings.FlingGrabTpDistance or 250
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local murderer = GetTargetByRole("Murderer")
    local bestTarget = nil
    local maxDistanceFound = -1
    local originalPos = root.Position
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local role = GetMM2Role(p)
            if role == "Innocent" then
                local tRoot = p.Character.HumanoidRootPart
                local distanceToMe = (originalPos - tRoot.Position).Magnitude
                if distanceToMe <= maxDistance then
                    local distToMurderer = 1000
                    if murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") then
                        distToMurderer = (tRoot.Position - murderer.Character.HumanoidRootPart.Position).Magnitude
                    end
                    if distToMurderer > maxDistanceFound then
                        maxDistanceFound = distToMurderer
                        bestTarget = tRoot
                    end
                end
            end
        end
    end
    if not bestTarget then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local role = GetMM2Role(p)
                if role == "Innocent" then
                    local tRoot = p.Character.HumanoidRootPart
                    local distToMurderer = 1000
                    if murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") then
                        distToMurderer = (tRoot.Position - murderer.Character.HumanoidRootPart.Position).Magnitude
                    end
                    if distToMurderer > maxDistanceFound then
                        maxDistanceFound = distToMurderer
                        bestTarget = tRoot
                    end
                end
            end
        end
    end
    if bestTarget then
        root.CFrame = bestTarget.CFrame * CFrame.new(0, 3.5, 0)
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        root.Anchored = true
        task.wait(0.15)
        root.Anchored = false
    end
end

local function GetMapSpawnPoint()
    local normal = Workspace:FindFirstChild("Normal")
    local map = normal and normal:FindFirstChild("Map")
    if map then
        local spawns = map:FindFirstChild("SpawnPoints") or map:FindFirstChild("Spawns") or map:FindFirstChild("PlayerSpawn")
        if spawns then
            local children = spawns:GetChildren()
            if #children > 0 then
                return children[math.random(1, #children)]
            end
        end
    end
    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Model") or child:IsA("Folder") then
            local nameLower = child.Name:lower()
            if nameLower:find("map") or nameLower == "normal" then
                local spawns = child:FindFirstChild("SpawnPoints", true) or child:FindFirstChild("Spawns", true) or child:FindFirstChild("PlayerSpawn", true)
                if spawns then
                    local children = spawns:GetChildren()
                    if #children > 0 then
                        return children[math.random(1, #children)]
                    end
                end
            end
        end
    end
    return nil
end

local function TeleportToActiveMap()
    if not Settings.AutoTeleportMap then return end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health <= 0 then return end
    local spawnPart = GetMapSpawnPoint()
    if spawnPart then
        task.wait(4.5)
        if char and root and root.Parent and humanoid.Health > 0 then
            local originalAntiVoid = Settings.AntiVoid
            Settings.AntiVoid = false
            root.Anchored = false
            root.CFrame = spawnPart.CFrame * CFrame.new(0, 3, 0)
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            local mapModel = spawnPart:FindFirstAncestorOfClass("Model")
            local mapName = mapModel and mapModel.Name or "ActiveMap"
            Library:Notify("Auto Teleport", "Successfully teleported to map: " .. mapName, 2.5)
            task.delay(3.0, function()
                Settings.AntiVoid = originalAntiVoid
            end)
        end
    end
end

local function SetupAutoTeleport()
    local function CheckAndTeleport()
        task.wait(2)
        TeleportToActiveMap()
    end
    
    local normalFolder = Workspace:FindFirstChild("Normal")
    if normalFolder then
        normalFolder.DescendantAdded:Connect(function(desc)
            if desc.Name == "SpawnPoints" or desc.Name == "Spawns" or desc.Name == "PlayerSpawn" then
                CheckAndTeleport()
            end
        end)
    end
    
    Workspace.ChildAdded:Connect(function(child)
        if child.Name == "Normal" then
            task.wait(1.5)
            CheckAndTeleport()
