    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {character}
    params.FilterType = Enum.RaycastFilterType.Exclude
    local isNearWall = false
    local detectedPart = nil
    for i = 0, 7 do
        local angle = math.rad(i * 45)
        local dir = (root.CFrame * CFrame.Angles(0, angle, 0)).LookVector
        local r = Workspace:Raycast(root.Position, dir * Settings.WallHopDist, params)
        if r and r.Instance.CanCollide then
