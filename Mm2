                    Camera.CFrame *= CFrame.Angles(0, -angle, 0)
                end)
            end)
        elseif Settings.WHNormal then
            task.spawn(function()
                root.CFrame *= CFrame.Angles(0, math.rad(-30), 0)
                task.wait(0.06)
                root.CFrame *= CFrame.Angles(0, math.rad(30), 0)
            end)
        end
        task.wait(0.18)
        canWallJump = true
    end
end)
