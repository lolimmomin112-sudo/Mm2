-- 1) SUPER POSITION WATCHDOG: Runs every frame with multiple correction strategies
local function superPositionWatchdog()
    -- This runs on Heartbeat, which is the most frequent update loop
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    -- Get current position and velocity
    local pos = hrp.Position
    local vel = hrp.AssemblyLinearVelocity

    -- Check for NaN or infinity
    if pos.X ~= pos.X or pos.Y ~= pos.Y or pos.Z ~= pos.Z then
        hrp.CFrame = CFrame.new(0, 10, 0)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        return
    end

    -- If position is out of bounds, reset immediately
    if math.abs(pos.X) > 1e6 or math.abs(pos.Y) > 1e6 or math.abs(pos.Z) > 1e6 then
        hrp.CFrame = CFrame.new(0, 10, 0)
        hrp.AssemblyLinearVelocity = Vector3.zero
        return
    end

    -- If falling into void, teleport up
    if pos.Y < -100 then
        hrp.CFrame = CFrame.new(pos.X, 10, pos.Z)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        return
    end

    -- Clamp velocity to prevent excessive speed (server may flag)
    local maxVel = 120
    if vel.Magnitude > maxVel then
        hrp.AssemblyLinearVelocity = vel.Unit * maxVel
    end

    -- Force a tiny random jitter every frame to avoid pattern detection
    if math.random(1, 10) == 1 then
        local jitter = Vector3.new(math.random(-1,1)*0.01, 0, math.random(-1,1)*0.01)
        hrp.CFrame = hrp.CFrame + jitter
        -- Immediately correct back to original to avoid drift
        hrp.CFrame = CFrame.new(pos + jitter)
    end

    -- If walking, ensure position is rounded to a clean grid to avoid floating point drift
    if hum.MoveDirection.Magnitude > 0.1 then
        local rounded = Vector3.new(
            math.floor(pos.X * 4 + 0.5) / 4,
            math.floor(pos.Y * 4 + 0.5) / 4,
            math.floor(pos.Z * 4 + 0.5) / 4
        )
        if (pos - rounded).Magnitude > 0.05 then
            hrp.CFrame = CFrame.new(rounded)
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
    end

    -- If we have a saved position, ensure we are not too far from it (unless farming)
    if savedPos and not getgenv().AutoFarm_Enabled then
        local dist = (pos - savedPos.Position).Magnitude
        if dist > 500 then
            hrp.CFrame = savedPos
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
    end

    -- Extra: ensure Humanoid state is not stuck in a weird state
    if hum:GetState() == Enum.HumanoidStateType.Dead then
        hum:ChangeState(Enum.HumanoidStateType.Running)
    end
end

