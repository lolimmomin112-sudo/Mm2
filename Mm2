            MockLines[1].Rotation = 0
            MockLines[2].Rotation = 0
            MockLines[3].Rotation = 0
            MockLines[4].Rotation = 0
        end
        if style == "Circle" then
            MockCircle.Size = UDim2.new(0, (size+gap)*2, 0, (size+gap)*2)
