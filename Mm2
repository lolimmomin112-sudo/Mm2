                        end
                        targetPos = predictedPos
                    end
                    args[2] = targetPos
                    return oldNamecall(self, table.unpack(args, 1, args.n))
                end
            end
            if (method == "Raycast" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRay") and LocalPlayer.Character:FindFirstChild("Gun") then
                local targetPlayer = GetTargetByRole("Murderer") or SelectedPlayer
                local targetPart = targetPlayer and targetPlayer.Character and (GetTargetBodyPart(targetPlayer.Character, Settings.TargetPart) or targetPlayer.Character:FindFirstChild("HumanoidRootPart"))
                if targetPart then
